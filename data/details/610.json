/td><td><span><span>Number</span></span></td><td></td></tr><tr><td colspan=\"3\"><span><span>1–4</span></span></td><td><span><span>임상의료데이터</span></span></td><td><span><span>clinic</span></span></td><td></td><td><span><span>Object</span></span></td><td><span><span>Y</span></span></td></tr><tr><td></td><td colspan=\"2\"><span><span>1–4–1</span></span></td><td><span><span>식별자</span></span></td><td><span><span>id</span></span></td><td></td><td><span><span>String</span></span></td><td><span><span>Y</span></span></td></tr><tr><td></td><td colspan=\"2\"><span><span>1–4–2</span></span></td><td><span><span>진단명</span></span></td><td><span><span>name</span></span></td><td></td><td><span><span>String</span></span></td><td><span><span>Y</span></span></td></tr><tr><td></td><td colspan=\"2\"><span><span>1–4–3</span></span></td><td><span><span>나이</span></span></td><td><span><span>age</span></span></td><td></td><td><span><span>Number</span></span></td><td><span><span>Y</span></span></td></tr><tr><td></td><td colspan=\"2\"><span><span>1–4–4</span></span></td><td><span><span>성별</span></span></td><td><span><span>sex</span></span></td><td></td><td><span><span>Number</span></span></td><td><span><span>Y</span></span></td></tr><tr><td></td><td colspan=\"2\"><span><span>1–4–5</span></span></td><td><span><span>통증점수</span></span></td><td><span><span>vas</span></span></td><td></td><td><span><span>Number</span></span></td><td><span><span>Y</span></span></td></tr><tr><td colspan=\"3\"><span><span>2</span></span></td><td><span><span>데이터셋 정보</span></span></td><td><span><span>Dataset</span></span></td><td></td><td><span><span>Object</span></span></td><td><span><span>Y</span></span></td></tr><tr><td colspan=\"3\"><span><span>2–1</span></span></td><td><span><span>데이터셋 식별자</span></span></td><td><span><span>identifier</span></span></td><td></td><td><span><span>String</span></span></td><td><span><span>Y</span></span></td></tr><tr><td colspan=\"3\"><span><span>2–2</span></span></td><td><span><span>데이터셋 이