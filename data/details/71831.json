span></span></td><td><span><span>string</span></span></td><td><span><span>N</span></span></td><td><span><span>“male”, “female”</span></span></td></tr><tr><td colspan=\"2\"><span><span>1-1-6</span></span></td><td><span><span>diagnosis</span></span></td><td><span><span>string</span></span></td><td><span><span>N</span></span></td><td></td></tr><tr><td colspan=\"3\"><span><span>1-2</span></span></td><td><span><span>file</span></span></td><td><span><span>object</span></span></td><td><span><span>Y</span></span></td><td></td></tr><tr><td></td><td></td><td colspan=\"2\"><span><span>1-2-1</span></span></td><td><span><span>file_type</span></span></td><td><span><span>string</span></span></td><td><span><span>Y</span></span></td><td><span><span>원시: R<br/> 합성: S</span></span></td></tr><tr><td></td><td></td><td colspan=\"2\"><span><span>1-2-2</span></span></td><td><span><span>file_name</span></span></td><td><span><span>string</span></span></td><td><span><span>Y</span></span></td><td></td></tr><tr><td></td><td></td><td colspan=\"2\"><span><span>1-2-3</span></span></td><td><span><span>patch_id</span></span></td><td><span><span>string</span></span></td><td><span><span>Y</span></span></td><td></td></tr><tr><td></td><td></td><td colspan=\"2\"><span><span>1-2-4</span></span></td><td><span><span>format</span></span></td><td><span><span>string</span></span></td><td><span><span>Y</span></span></td><td><span><span>“PNG”</span></span></td></tr><tr><td></td><td></td><td colspan=\"2\"><span><span>1-2-5</span></span></td><td><span><span>mpp</span></span></td><td><span><span>number</span></span></td><td><span><span>Y</span></span></td><td></td></tr><tr><td></td><td></td><td colspan=\"2\"><span><span>1-2-6</span></span></td><td><span><span>filesize</span></span></td><td><span><span>string</span></span></td><td><span><span>Y</span></span></td><td></td></tr><tr><td></td><td></td><td colspan=\"2\"><span><span>1-2-7</span></span></td><td><span><span>width</span></span></td><td><span><span>number</spa